# Random GitHub-style Python snippet:
# Finds duplicate files in a folder using SHA256 hashing

import os
import hashlib

def file_hash(path):
    hasher = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(8192):
            hasher.update(chunk)
    return hasher.hexdigest()

def find_duplicates(folder):
    hashes = {}
    duplicates = []

    for root, _, files in os.walk(folder):
        for file in files:
            path = os.path.join(root, file)

            try:
                h = file_hash(path)

                if h in hashes:
                    duplicates.append((path, hashes[h]))
                else:
                    hashes[h] = path

            except Exception as e:
                print(f"Error reading {path}: {e}")

    return duplicates

folder_path = input("Enter folder path: ")

dupes = find_duplicates(folder_path)

if dupes:
    print("\nDuplicate files found:\n")
    for dup, original in dupes:
        print(f"Duplicate: {dup}")
        print(f"Original : {original}\n")
else:
    print("No duplicate files found.")
